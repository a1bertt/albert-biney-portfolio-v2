---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects", ({ data }) => data.category === "stills")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder
);
---

<BaseLayout title="Albert Biney">
  <section class="stills-index" aria-label="Stills projects">
    {
      projects.map((project) => (
        <a class="project-card" href={`/work/${project.data.slug}`} aria-label={`View ${project.data.title}`}>
          <img src={project.data.coverImage} alt={project.data.title} loading="lazy" />
          <span class="project-card__title">{project.data.title}</span>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .stills-index {
    column-count: 3;
    column-gap: 12px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px var(--space-6) 80px;
  }

  .project-card {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 12px;
    overflow: hidden;
    break-inside: avoid;
    background: var(--color-text);
  }

  .project-card img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity var(--motion-fast);
  }

  .project-card::after {
    position: absolute;
    inset: 0;
    content: "";
    background: rgba(0, 0, 0, 0.42);
    opacity: 0;
    transition: opacity var(--motion-fast);
  }

  .project-card__title {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 80%;
    color: #ffffff;
    font-size: clamp(48px, 4.6vw, 64px);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
    text-align: center;
    text-transform: none;
    word-break: normal;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity var(--motion-fast);
  }

  .project-card:hover::after,
  .project-card:focus-visible::after,
  .project-card:hover .project-card__title,
  .project-card:focus-visible .project-card__title {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .stills-index {
      column-count: 2;
      column-gap: 8px;
      padding: 16px var(--space-4) 64px;
    }

    .project-card {
      margin-bottom: 8px;
    }

    .project-card__title {
      font-size: clamp(42px, 5vw, 52px);
    }
  }

  @media (max-width: 720px) {
    .stills-index {
      padding-top: var(--space-4);
    }

    .project-card::after {
      opacity: 0.24;
    }

    .project-card__title {
      font-size: clamp(28px, 8vw, 36px);
      opacity: 1;
    }
  }

  @media (max-width: 300px) {
    .stills-index {
      column-count: 1;
    }
  }
</style>
