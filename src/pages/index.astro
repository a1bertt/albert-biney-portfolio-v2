---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects", ({ data }) => data.category === "stills")).sort(
  (a, b) => a.data.sortOrder - b.data.sortOrder
);
---

<BaseLayout title="Albert Biney">
  <section class="stills-index" aria-label="Stills projects">
    {
      projects.map((project) => (
        <a class="project-card" href={`/work/${project.data.slug}`} aria-label={`View ${project.data.title}`}>
          <img src={project.data.coverImage} alt={project.data.title} loading="lazy" />
          <span class="project-card__title">{project.data.title}</span>
        </a>
      ))
    }
  </section>
</BaseLayout>

<style>
  .stills-index {
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    gap: clamp(40px, 7vw, 112px) clamp(20px, 3.4vw, 48px);
    align-items: start;
    max-width: var(--layout-max-width);
    padding: clamp(32px, 5vw, 72px) var(--layout-page-x) clamp(72px, 10vw, 144px);
  }

  .project-card {
    position: relative;
    grid-column: span 5;
    display: block;
    overflow: hidden;
    background: var(--color-text);
  }

  .project-card:nth-child(6n + 1) {
    grid-column: 1 / span 6;
  }

  .project-card:nth-child(6n + 2) {
    grid-column: 9 / span 4;
    margin-top: clamp(56px, 10vw, 144px);
  }

  .project-card:nth-child(6n + 3) {
    grid-column: 4 / span 4;
    margin-top: clamp(16px, 4vw, 64px);
  }

  .project-card:nth-child(6n + 4) {
    grid-column: 10 / span 5;
    margin-top: clamp(-24px, -2vw, -8px);
  }

  .project-card:nth-child(6n + 5) {
    grid-column: 2 / span 3;
    margin-top: clamp(72px, 12vw, 160px);
  }

  .project-card:nth-child(6n) {
    grid-column: 6 / span 6;
    margin-top: clamp(24px, 6vw, 96px);
  }

  .project-card:nth-child(5n + 1) img {
    aspect-ratio: 5 / 6;
  }

  .project-card:nth-child(5n + 2) img {
    aspect-ratio: 3 / 4;
  }

  .project-card:nth-child(5n + 3) img {
    aspect-ratio: 1 / 1;
  }

  .project-card:nth-child(5n + 4) img {
    aspect-ratio: 4 / 5;
  }

  .project-card:nth-child(5n) img {
    aspect-ratio: 16 / 11;
  }

  .project-card img {
    display: block;
    width: 100%;
    object-fit: cover;
    transition: opacity var(--motion-fast);
  }

  .project-card::after {
    position: absolute;
    inset: 0;
    content: "";
    background: rgba(0, 0, 0, 0.42);
    opacity: 0;
    transition: opacity var(--motion-fast);
  }

  .project-card__title {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 80%;
    color: #ffffff;
    font-size: clamp(48px, 4.6vw, 64px);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
    text-align: center;
    text-transform: none;
    word-break: normal;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity var(--motion-fast);
  }

  .project-card:hover::after,
  .project-card:focus-visible::after,
  .project-card:hover .project-card__title,
  .project-card:focus-visible .project-card__title {
    opacity: 1;
  }

  @media (max-width: 960px) {
    .stills-index {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    .project-card,
    .project-card:nth-child(6n + 1),
    .project-card:nth-child(6n + 2),
    .project-card:nth-child(6n + 3),
    .project-card:nth-child(6n + 4),
    .project-card:nth-child(6n + 5),
    .project-card:nth-child(6n) {
      grid-column: span 5;
    }

    .project-card:nth-child(even) {
      grid-column: 4 / span 5;
    }

    .project-card__title {
      font-size: clamp(42px, 5vw, 52px);
    }
  }

  @media (max-width: 720px) {
    .stills-index {
      grid-template-columns: 1fr;
      gap: var(--space-7);
      padding-top: var(--space-5);
    }

    .project-card,
    .project-card:nth-child(6n + 1),
    .project-card:nth-child(6n + 2),
    .project-card:nth-child(6n + 3),
    .project-card:nth-child(6n + 4),
    .project-card:nth-child(6n + 5),
    .project-card:nth-child(6n),
    .project-card:nth-child(even) {
      grid-column: auto;
      margin-top: 0;
    }

    .project-card::after {
      opacity: 0.24;
    }

    .project-card__title {
      font-size: clamp(28px, 8vw, 36px);
      opacity: 1;
    }
  }
</style>
