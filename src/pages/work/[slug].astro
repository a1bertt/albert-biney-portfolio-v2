---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectMasonryGallery from "../../components/ProjectMasonryGallery.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.category === "stills");

  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, year, client, credits, images } = project.data;
---

<BaseLayout title={`${title} | Albert Biney`}>
  <article class="project-page">
    <header class="project-header">
      <h1>{title}</h1>
      <p>{year}</p>

      {client && <p>Client: {client}</p>}

      {credits && credits.length > 0 && (
        <dl class="project-credits">
          {
            credits.map((credit) => (
              <>
                <dt>{credit.role}</dt>
                <dd>{credit.name}</dd>
              </>
            ))
          }
        </dl>
      )}
    </header>

    <ProjectMasonryGallery images={images} projectTitle={title} />
  </article>
</BaseLayout>

<style>
  .project-page {
    padding: 40px 32px 80px;
  }

  .project-header {
    max-width: 560px;
    margin-bottom: 48px;
  }

  .project-header h1 {
    margin: 0 0 12px;
    font-size: 28px;
    font-weight: 500;
  }

  .project-header p {
    margin: 0 0 8px;
    color: var(--muted);
  }

  .project-credits {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 16px;
    margin: 24px 0 0;
  }

  .project-credits dt,
  .project-credits dd {
    margin: 0;
  }

  .project-credits dt {
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .project-page {
      padding: var(--space-5) var(--layout-page-x) 80px;
    }
  }
</style>
