---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.category === "moving-image");

  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, year, client, credits, images, videos } = project.data;
const primaryVideo = videos?.[0]?.streamUrl;
---

<BaseLayout title={`${title} | Albert Biney`}>
  <article class="project-page">
    <header class="project-header">
      <h1>{title}</h1>
      <p>{year}</p>

      {client && <p>Client: {client}</p>}

      {credits && credits.length > 0 && (
        <dl class="project-credits">
          {
            credits.map((credit) => (
              <>
                <dt>{credit.role}</dt>
                <dd>{credit.name}</dd>
              </>
            ))
          }
        </dl>
      )}
    </header>

    {primaryVideo && (
      <div class="project-video">
        <iframe
          src={primaryVideo}
          title={`${title} video`}
          loading="lazy"
          allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
          allowfullscreen
        ></iframe>
      </div>
    )}

    {images.length > 0 && (
      <div class="project-images">
        {
          images.map((image, index) => (
            <figure>
              <img src={image} alt={`${title}, image ${index + 1}`} loading={index === 0 ? "eager" : "lazy"} />
            </figure>
          ))
        }
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .project-page {
    padding: 40px 32px 80px;
  }

  .project-header {
    max-width: 560px;
    margin-bottom: 48px;
  }

  .project-header h1 {
    margin: 0 0 12px;
    font-size: 28px;
    font-weight: 500;
  }

  .project-header p {
    margin: 0 0 8px;
    color: var(--muted);
  }

  .project-credits {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 8px 16px;
    margin: 24px 0 0;
  }

  .project-credits dt,
  .project-credits dd {
    margin: 0;
  }

  .project-credits dt {
    color: var(--muted);
  }

  .project-video {
    max-width: 960px;
    margin-bottom: 32px;
  }

  .project-video iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    background: var(--color-text);
  }

  .project-images {
    display: grid;
    gap: 32px;
    max-width: 960px;
  }

  .project-images figure {
    margin: 0;
  }

  .project-images img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
