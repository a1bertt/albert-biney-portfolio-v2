---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects", ({ data }) => data.category === "moving-image"))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .map((project) => {
    const video = project.data.videos?.[0];

    return {
      project,
      previewImage: video?.posterImage ?? project.data.coverImage,
      videoUrl: video?.previewUrl ?? video?.fullVideoUrl,
    };
  });
---

<BaseLayout title="Moving Images | Albert Biney">
  <section class="moving-index" aria-label="Moving image projects">
    {
      projects.length > 0 ? (
        projects.map(({ project, previewImage, videoUrl }) => (
          <a
            class="project-card"
            href={`/moving-images/${project.data.slug}`}
            aria-label={`View ${project.data.title}`}
          >
            {videoUrl ? (
              <video
                class="project-card__media"
                src={videoUrl}
                poster={previewImage}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={project.data.title}
              />
            ) : (
              <img
                class="project-card__media"
                src={previewImage}
                alt={project.data.title}
                loading="lazy"
              />
            )}
            <span class="project-card__title">{project.data.title}</span>
          </a>
        ))
      ) : (
        <p class="moving-index__empty">Moving image projects coming soon.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .moving-index {
    column-count: 3;
    column-gap: 12px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 32px var(--space-6) 80px;
  }

  .project-card {
    position: relative;
    display: block;
    width: 100%;
    margin: 0 0 12px;
    overflow: hidden;
    break-inside: avoid;
    background: var(--color-text);
  }

  .project-card__media {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity var(--motion-fast);
  }

  .project-card::after {
    position: absolute;
    inset: 0;
    content: "";
    background: rgba(0, 0, 0, 0.42);
    opacity: 0;
    transition: opacity var(--motion-fast);
  }

  .project-card__title {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 80%;
    color: #ffffff;
    font-size: clamp(48px, 4.6vw, 64px);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
    text-align: center;
    text-transform: none;
    word-break: normal;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity var(--motion-fast);
  }

  .project-card:hover::after,
  .project-card:focus-visible::after,
  .project-card:hover .project-card__title,
  .project-card:focus-visible .project-card__title {
    opacity: 1;
  }

  .moving-index__empty {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--type-nav-size);
    letter-spacing: var(--type-letter-spaced);
    line-height: 1.4;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .moving-index {
      column-count: 2;
      column-gap: 8px;
      padding: 16px var(--space-4) 64px;
    }

    .project-card {
      margin-bottom: 8px;
    }

    .project-card__title {
      font-size: clamp(42px, 5vw, 52px);
    }
  }

  @media (max-width: 720px) {
    .moving-index {
      padding-top: var(--space-4);
    }

    .project-card::after {
      opacity: 0.24;
    }

    .project-card__title {
      font-size: clamp(28px, 8vw, 36px);
      opacity: 1;
    }
  }

  @media (max-width: 300px) {
    .moving-index {
      column-count: 1;
    }
  }
</style>
