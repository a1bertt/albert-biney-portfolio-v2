---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects", ({ data }) => data.category === "moving-image"))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder)
  .map((project) => {
    const video = project.data.videos?.[0];

    return {
      project,
      previewImage: video?.posterImage ?? project.data.coverImage,
      videoUrl: video?.previewUrl ?? video?.fullVideoUrl,
    };
  });
---

<BaseLayout title="Moving Images | Albert Biney">
  <section class="moving-index" aria-label="Moving image projects">
    {
      projects.length > 0 ? (
        projects.map(({ project, previewImage, videoUrl }) => (
          <a
            class="project-card"
            href={`/moving-images/${project.data.slug}`}
            aria-label={`View ${project.data.title}`}
          >
            {videoUrl ? (
              <video
                class="project-card__media"
                src={videoUrl}
                poster={previewImage}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={project.data.title}
              />
            ) : (
              <img
                class="project-card__media"
                src={previewImage}
                alt={project.data.title}
                loading="lazy"
              />
            )}
            <span class="project-card__title">{project.data.title}</span>
          </a>
        ))
      ) : (
        <p class="moving-index__empty">Moving image projects coming soon.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .moving-index {
    display: grid;
    grid-auto-flow: dense;
    grid-template-columns: repeat(14, minmax(0, 1fr));
    gap: clamp(40px, 7vw, 112px) clamp(20px, 3.4vw, 48px);
    align-items: start;
    max-width: var(--layout-max-width);
    padding: clamp(32px, 5vw, 72px) var(--layout-page-x) clamp(72px, 10vw, 144px);
  }

  .project-card {
    position: relative;
    grid-column: span 5;
    display: block;
    overflow: hidden;
    background: var(--color-text);
  }

  .project-card:nth-child(6n + 1) {
    grid-column: 1 / span 6;
  }

  .project-card:nth-child(6n + 2) {
    grid-column: 9 / span 4;
    margin-top: clamp(56px, 10vw, 144px);
  }

  .project-card:nth-child(6n + 3) {
    grid-column: 4 / span 4;
    margin-top: clamp(16px, 4vw, 64px);
  }

  .project-card:nth-child(6n + 4) {
    grid-column: 10 / span 5;
    margin-top: clamp(-24px, -2vw, -8px);
  }

  .project-card:nth-child(6n + 5) {
    grid-column: 2 / span 3;
    margin-top: clamp(72px, 12vw, 160px);
  }

  .project-card:nth-child(6n) {
    grid-column: 6 / span 6;
    margin-top: clamp(24px, 6vw, 96px);
  }

  .project-card:nth-child(5n + 1) .project-card__media {
    aspect-ratio: 5 / 6;
  }

  .project-card:nth-child(5n + 2) .project-card__media {
    aspect-ratio: 3 / 4;
  }

  .project-card:nth-child(5n + 3) .project-card__media {
    aspect-ratio: 1 / 1;
  }

  .project-card:nth-child(5n + 4) .project-card__media {
    aspect-ratio: 4 / 5;
  }

  .project-card:nth-child(5n) .project-card__media {
    aspect-ratio: 16 / 11;
  }

  .project-card__media {
    display: block;
    width: 100%;
    object-fit: cover;
    transition: opacity var(--motion-fast);
  }

  .project-card::after {
    position: absolute;
    inset: 0;
    content: "";
    background: rgba(0, 0, 0, 0.42);
    opacity: 0;
    transition: opacity var(--motion-fast);
  }

  .project-card__title {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    width: 80%;
    color: #ffffff;
    font-size: clamp(48px, 4.6vw, 64px);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
    text-align: center;
    text-transform: none;
    word-break: normal;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity var(--motion-fast);
  }

  .project-card:hover::after,
  .project-card:focus-visible::after,
  .project-card:hover .project-card__title,
  .project-card:focus-visible .project-card__title {
    opacity: 1;
  }

  .moving-index__empty {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--type-nav-size);
    letter-spacing: var(--type-letter-spaced);
    line-height: 1.4;
    text-transform: uppercase;
  }

  @media (max-width: 960px) {
    .moving-index {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    .project-card,
    .project-card:nth-child(6n + 1),
    .project-card:nth-child(6n + 2),
    .project-card:nth-child(6n + 3),
    .project-card:nth-child(6n + 4),
    .project-card:nth-child(6n + 5),
    .project-card:nth-child(6n) {
      grid-column: span 5;
    }

    .project-card:nth-child(even) {
      grid-column: 4 / span 5;
    }

    .project-card__title {
      font-size: clamp(42px, 5vw, 52px);
    }
  }

  @media (max-width: 720px) {
    .moving-index {
      grid-template-columns: 1fr;
      gap: var(--space-7);
      padding-top: var(--space-5);
    }

    .project-card,
    .project-card:nth-child(6n + 1),
    .project-card:nth-child(6n + 2),
    .project-card:nth-child(6n + 3),
    .project-card:nth-child(6n + 4),
    .project-card:nth-child(6n + 5),
    .project-card:nth-child(6n),
    .project-card:nth-child(even) {
      grid-column: auto;
      margin-top: 0;
    }

    .project-card::after {
      opacity: 0.24;
    }

    .project-card__title {
      font-size: clamp(28px, 8vw, 36px);
      opacity: 1;
    }
  }
</style>
