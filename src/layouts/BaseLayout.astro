---
import "../styles/global.css";

const {
  title = "Albert Biney",
  description = "Photographer working across film and digital, focusing on portraiture and fashion.",
  ogImage,
} = Astro.props;

const resolvedOgImage = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).toString() : undefined;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isStills = currentPath === "/" || currentPath.startsWith("/work/");
const isMovingImages = currentPath === "/moving-images" || currentPath.startsWith("/moving-images/");
const isInfo = currentPath === "/info";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
  </head>

  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <aside class="site-sidebar" aria-label="Site navigation">
      <a href="/" class="site-name">ALBERT BINEY</a>

      <nav class="site-nav" aria-label="Main navigation">
        <a href="/" aria-current={isStills ? "page" : undefined}>STILLS</a>
        <a href="/moving-images" aria-current={isMovingImages ? "page" : undefined}>MOVING IMAGES</a>
        <a href="/info" aria-current={isInfo ? "page" : undefined}>INFO</a>
      </nav>
    </aside>

    <main id="main-content" class="page-content">
      <slot />
    </main>
  </body>
</html>
